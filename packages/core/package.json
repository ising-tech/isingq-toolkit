{
  "name": "@ising-tech/isingq-core",
  "version": "0.9.0",
  "description": "Shared local runtime for IsingQ QUBO modeling, validation and solving adapters",
  "keywords": [
    "isingq",
    "ising-machine",
    "qubo",
    "combinatorial-optimization",
    "binary-optimization",
    "solver",
    "optimization"
  ],
  "type": "commonjs",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./isingq": "./src/isingq.js",
    "./knowledge": "./src/knowledge.js",
    "./modeling": "./src/modeling.js",
    "./qubo": "./src/qubo.js",
    "./resources": "./src/resources.js",
    "./setup": "./src/setup.js",
    "./store": "./src/store.js",
    "./tools": "./src/tools.js"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md",
    "API.md",
    "MODEL-DIGEST.md",
    "VERIFIED-REPORT.md",
    "REVIEW-FILE.md",
    "knowledge/",
    "src/"
  ],
  "scripts": {
    "check": "node ../../scripts/check-syntax.cjs src",
    "prepublishOnly": "npm --prefix ../.. test && npm --prefix ../.. run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ising-tech/isingq-toolkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ising-tech/isingq-toolkit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ising-tech/isingq-toolkit/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "undici": "6.29.1"
  }
}
