{
  "name": "@ising-tech/isingq-mcp",
  "version": "0.9.1",
  "mcpName": "io.github.ising-tech/isingq-mcp",
  "description": "IsingQ MCP for guided QUBO modeling, cloud solving and private-network local solvers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "isingq",
    "ising-machine",
    "qubo",
    "combinatorial-optimization",
    "binary-optimization",
    "agent-tools",
    "local-first",
    "photonic-computing"
  ],
  "type": "commonjs",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./core": "./packages/core/src/index.js"
  },
  "bin": {
    "isingq-mcp": "bin/isingq-mcp.js"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "server.json",
    "bin/",
    "install/",
    "packages/core/",
    "skills/",
    "src/"
  ],
  "workspaces": [
    "packages/core",
    "packages/dsh-plugin"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.cjs bin src packages scripts test test-support eslint.config.cjs && npm run lint",
    "build:binaries": "node scripts/build-binaries.js",
    "pack:mcp": "node scripts/pack-mcp.js",
    "prepublishOnly": "npm test && npm run check",
    "verify:dsh": "node scripts/verify-dsh-plugin.js",
    "lint": "eslint --max-warnings=0 ."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ising-tech/isingq-toolkit.git"
  },
  "homepage": "https://github.com/ising-tech/isingq-toolkit#readme",
  "bugs": {
    "url": "https://github.com/ising-tech/isingq-toolkit/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.25.12",
    "eslint": "10.15.0",
    "globals": "16.5.0"
  },
  "dependencies": {
    "undici": "6.29.1"
  }
}
